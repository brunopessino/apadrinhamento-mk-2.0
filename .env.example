# ---------------------------------------------------------------
# Apadrinhamento MK 2.0 — variáveis de ambiente (build do Vite)
# Copie para .env.local (desenvolvimento) ou cadastre no Netlify
# (Site settings > Environment variables). NUNCA versione .env.
# Os valores abaixo são os identificadores PÚBLICOS do app web do
# Firebase (não são segredos), mas devem vir do projeto escolhido
# para 2026 — veja docs/IMPLANTACAO.md.
# ---------------------------------------------------------------

# "firebase" (produção/homologação) ou "demo" (dados sintéticos, sem backend)
VITE_DATA_MODE=firebase

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase App Check (reCAPTCHA v3). Camada complementar; vazio = desativado.
VITE_APPCHECK_SITE_KEY=

# Fotografias: "inline" (miniaturas no Firestore, sem custo extra) ou
# "storage" (Firebase Storage — exige plano Blaze em buckets novos).
VITE_PHOTO_MODE=inline

# Contato institucional exibido no rodapé (opcionais; nada é inventado se vazio)
VITE_CONTACT_EMAIL=
VITE_CONTACT_PHONE=

# URL pública do site (compartilhamento)
VITE_SITE_URL=
